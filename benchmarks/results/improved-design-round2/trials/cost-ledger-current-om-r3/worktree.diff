+function captureWorkerCost(pi: ExtensionAPI): void {
+	const path = process.env.OM_COST_PATH;
+	if (!path) return;
+	let total = 0;
+	pi.on("message_end", (event: any) => {
+		const cost = event?.message?.role === "assistant" ? event.message.usage?.cost?.total : undefined;
+		if (typeof cost !== "number" || !Number.isFinite(cost) || cost < 0) return;
+		total += cost;
+		if (Number.isFinite(total)) writeWorkerCost(path, total);
+	});
+}
 
