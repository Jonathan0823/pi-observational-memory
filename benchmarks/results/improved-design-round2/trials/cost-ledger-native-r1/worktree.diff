+export type WorkerCostResult = { cost: number };
+
+export function runCostPath(cwd: string, runId: string): string {
+	return join(runsDir(cwd), `${runId}.cost.json`);
+}
+
+export function validUsageCost(value: unknown): value is number {
+	return typeof value === "number" && Number.isFinite(value) && value >= 0;
+}
+
+export function writeWorkerCost(path: string, cost: unknown): void {
+	if (validUsageCost(cost)) atomicWrite(path, JSON.stringify({ cost }));
+}
+
+export function readWorkerCost(path: string): number | undefined {
+	try {
+		const raw = JSON.parse(readFileSync(path, "utf-8")) as unknown;
+		if (!raw || typeof raw !== "object") return undefined;
+		const cost = (raw as { cost?: unknown }).cost;
+		return validUsageCost(cost) ? cost : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
 export function runsDir(cwd: string): string {
 	return join(cwd, ".memory", ".runs");
 }
