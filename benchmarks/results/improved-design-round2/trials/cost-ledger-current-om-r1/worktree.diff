+export type WorkerCostEntryData = { runId: string; role: "observer" | "consolidator"; cost: number };
+
+export function isWorkerCostEntryData(value: unknown): value is WorkerCostEntryData {
+	if (!isPlainRecord(value)) return false;
+	return (
+		isNonEmptyString(value.runId) &&
+		(value.role === "observer" || value.role === "consolidator") &&
+		typeof value.cost === "number" &&
+		Number.isFinite(value.cost) &&
+		value.cost >= 0
+	);
+}
+
+/** Sum all valid cost entries in the supplied full-session entry set (including inactive branches). */
+export function totalWorkerCost(entries: Entry[]): number {
+	return entries.reduce((total, entry) => {
+		if (entry.type !== "custom" || entry.customType !== OM_WORKER_COST || !isWorkerCostEntryData(entry.data)) return total;
+		const sum = total + entry.data.cost;
+		return Number.isFinite(sum) ? sum : total;
+	}, 0);
+}
