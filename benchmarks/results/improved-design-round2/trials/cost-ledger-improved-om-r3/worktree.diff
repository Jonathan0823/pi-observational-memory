@@ -21,6 +21,25 @@ export type ObserverRunResult = {
 	observations: RawObservation[];
 };
 
+export type WorkerCost = { role: "observer" | "consolidator"; runId: string; cost: number };
+
+export function workerCostPath(cwd: string, runId: string): string {
+	return join(runsDir(cwd), `${runId}.cost.json`);
+}
+
+export function readWorkerCost(path: string): WorkerCost | undefined {
+	try {
+		const raw = JSON.parse(readFileSync(path, "utf-8")) as Record<string, unknown>;
+		if ((raw.role !== "observer" && raw.role !== "consolidator") || typeof raw.runId !== "string" ||
+			typeof raw.cost !== "number" || !Number.isFinite(raw.cost) || raw.cost < 0) return undefined;
+		return { role: raw.role, runId: raw.runId, cost: raw.cost };
+	} catch { return undefined; }
+}
+
+export function writeWorkerCost(path: string, value: WorkerCost): void {
+	atomicWrite(path, JSON.stringify(value));
+}
+
 export function runsDir(cwd: string): string {
 	return join(cwd, ".memory", ".runs");
 }
