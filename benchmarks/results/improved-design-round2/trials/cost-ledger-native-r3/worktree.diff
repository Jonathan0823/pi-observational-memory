+/** Sum valid pi assistant-message costs, ignoring malformed usage and overflow. */
+export function sumAssistantMessageCosts(messages: unknown[]): number | undefined {
+	let total = 0;
+	let found = false;
+	for (const message of messages) {
+		if (!message || typeof message !== "object") continue;
+		const item = message as { role?: unknown; usage?: { cost?: { total?: unknown } } };
+		if (item.role !== "assistant") continue;
+		const cost = item.usage?.cost?.total;
+		if (typeof cost !== "number" || !Number.isFinite(cost) || cost < 0) continue;
+		const next = total + cost;
+		if (!Number.isFinite(next)) continue;
+		total = next;
+		found = true;
+	}
+	return found ? total : undefined;
+}
