+export function workerCostPath(cwd: string, runId: string): string {
+	return join(runsDir(cwd), `${runId}.cost.json`);
+}
+
+/** Read a finite, non-negative total cost. Invalid/missing usage is intentionally ignored. */
+export function readWorkerCost(path: string): number | undefined {
+	try {
+		const raw: unknown = JSON.parse(readFileSync(path, "utf-8"));
+		if (!raw || typeof raw !== "object") return undefined;
+		const cost = (raw as { usageCost?: unknown }).usageCost;
+		return typeof cost === "number" && Number.isFinite(cost) && cost >= 0 ? cost : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+export function writeWorkerCost(path: string, usageCost: number): void {
+	if (Number.isFinite(usageCost) && usageCost >= 0) atomicWrite(path, JSON.stringify({ usageCost }));
+}
+
 /** Atomic write (temp + rename) so a reader never sees a half-written file. */
 export function atomicWrite(path: string, content: string): void {
 	mkdirSync(dirname(path), { recursive: true });
