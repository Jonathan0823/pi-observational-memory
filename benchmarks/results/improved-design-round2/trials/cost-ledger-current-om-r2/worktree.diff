+/** Persist cost independently of observations so it survives an unsuccessful worker run. */
+export function writeWorkerCost(path: string, cost: number): void {
+	if (!isValidWorkerCost(cost)) return;
+	let observations: RawObservation[] = [];
+	try {
+		observations = readObserverResult(path).observations;
+	} catch {
+		// A missing or not-yet-initialized result file is fine for consolidator workers.
+	}
