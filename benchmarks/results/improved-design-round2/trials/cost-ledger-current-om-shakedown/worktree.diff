 export function writeObserverResult(path: string, result: ObserverRunResult): void {
 	atomicWrite(path, JSON.stringify(result));
 }
+
+export function isValidWorkerCost(value: unknown): value is number {
+	return typeof value === "number" && Number.isFinite(value) && value >= 0;
+}
+
+/** Read only the cost field; absent, unreadable, and malformed IPC is intentionally ignored. */
+export function recordWorkerCost(path: string, cost: number): void {
+	if (!isValidWorkerCost(cost)) return;
+	let current: Record<string, unknown> = {};
+	try {
+		const parsed: unknown = JSON.parse(readFileSync(path, "utf-8"));
+		if (parsed && typeof parsed === "object") current = parsed as Record<string, unknown>;
+	} catch {
+		// A cost-only consolidator result starts as an empty object.
+	}
+	const previous = isValidWorkerCost(current.cost) ? current.cost : 0;
+	atomicWrite(path, JSON.stringify({ ...current, cost: previous + cost }));
+}
+
+export function readWorkerCost(path: string): number | undefined {
+	try {
+		const raw: unknown = JSON.parse(readFileSync(path, "utf-8"));
+		if (!raw || typeof raw !== "object") return undefined;
+		const cost = (raw as Record<string, unknown>).cost;
+		return isValidWorkerCost(cost) ? cost : undefined;
+	} catch {
+		return undefined;
+	}
+}
