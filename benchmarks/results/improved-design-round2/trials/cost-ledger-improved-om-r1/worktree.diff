+++ b/src/spawn/runs.ts
@@ -21,6 +21,29 @@ export type ObserverRunResult = {
 	observations: RawObservation[];
 };
 
+export type WorkerUsage = { cost: number };
+
+export function usageResultPath(cwd: string, runId: string): string {
+	return join(runsDir(cwd), `${runId}.usage.json`);
+}
+
+export function validWorkerCost(value: unknown): value is number {
+	return typeof value === "number" && Number.isFinite(value) && value >= 0;
+}
+
+export function readWorkerUsage(path: string): WorkerUsage | undefined {
+	try {
+		const value = JSON.parse(readFileSync(path, "utf-8")) as { cost?: unknown };
+		return value && validWorkerCost(value.cost) ? { cost: value.cost } : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+export function writeWorkerUsage(path: string, cost: number): void {
+	if (validWorkerCost(cost)) atomicWrite(path, JSON.stringify({ cost }));
+}
+
 export function runsDir(cwd: string): string {
 	return join(cwd, ".memory", ".runs");
 }
