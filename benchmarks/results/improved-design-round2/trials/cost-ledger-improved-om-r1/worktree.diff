 /** Per-session on/off gate state (default OFF). See src/index.ts. */
 export const OM_ENABLED = "om.enabled";
+/** Actual pi usage cost reported by a worker, independent of its success or branch. */
+export const OM_WORKER_COST = "om.worker.cost";
+
+export type WorkerCostRole = "observer" | "consolidator";
+export type WorkerCostData = { role: WorkerCostRole; runId: string; cost: number };
+
+export function isWorkerCostData(value: unknown): value is WorkerCostData {
+	if (!value || typeof value !== "object") return false;
+	const data = value as Record<string, unknown>;
+	return (data.role === "observer" || data.role === "consolidator") &&
+		typeof data.runId === "string" && data.runId.length > 0 &&
+		typeof data.cost === "number" && Number.isFinite(data.cost) && data.cost >= 0;
+}
+
+export function totalWorkerCost(entries: Entry[]): number {
+	let total = 0;
+	for (const entry of entries) {
+		if (entry.type === "custom" && entry.customType === OM_WORKER_COST && isWorkerCostData(entry.data)) total += entry.data.cost;
+	}
+	return total;
+}
