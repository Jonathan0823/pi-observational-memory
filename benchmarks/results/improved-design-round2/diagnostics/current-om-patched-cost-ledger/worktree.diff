+export type WorkerCostResult = { cost: number };
+export function workerCostResultPath(cwd: string, runId: string): string {
+	return join(runsDir(cwd), `${runId}.cost.json`);
+}
+export function writeWorkerCost(path: string, cost: number): void {
+	if (Number.isFinite(cost) && cost >= 0) atomicWrite(path, JSON.stringify({ cost }));
+}
+export function readWorkerCost(path: string): number | undefined {
+	try {
+		const value = JSON.parse(readFileSync(path, "utf-8")) as { cost?: unknown };
+		return typeof value.cost === "number" && Number.isFinite(value.cost) && value.cost >= 0 ? value.cost : undefined;
+	} catch { return undefined; }
+}
+
 export function runsDir(cwd: string): string {
 	return join(cwd, ".memory", ".runs");
 }
