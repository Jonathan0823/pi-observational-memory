 export const OM_FOLDED = "om.folded";
 /** Per-session on/off gate state (default OFF). See src/index.ts. */
 export const OM_ENABLED = "om.enabled";
+/** Actual model cost reported by a worker run. */
+export const OM_WORKER_COST = "om.worker.cost";
+
+export type WorkerCostData = { role: "observer" | "consolidator"; runId: string; cost: number };
+
+export function isWorkerCostData(value: unknown): value is WorkerCostData {
+	if (!value || typeof value !== "object") return false;
+	const v = value as Record<string, unknown>;
+	return (v.role === "observer" || v.role === "consolidator") && typeof v.runId === "string" && v.runId.length > 0 &&
+		typeof v.cost === "number" && Number.isFinite(v.cost) && v.cost >= 0;
+}
+
+export function totalWorkerCost(entries: Entry[]): number {
+	let total = 0;
+	for (const entry of entries) {
+		if (entry.type === "custom" && entry.customType === OM_WORKER_COST && isWorkerCostData(entry.data)) total += entry.data.cost;
+	}
+	return total;
+}
 /**
  * Synthetic continuation message used to resume the agent loop after a mid-run compaction
  * (a `turn_end` that was NOT the run's terminal turn). Carried as a `role: "custom"` message
