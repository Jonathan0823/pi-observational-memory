 /** Observer output committed by the orchestrator; the buffer tier. */
 export const OM_OBSERVATIONS_RECORDED = "om.observations.recorded";
+export const OM_WORKER_COST = "om.worker.cost";
+export type WorkerCostData = { role: "observer" | "consolidator"; runId: string; cost: number };
+
+export function isWorkerCostData(value: unknown): value is WorkerCostData {
+	if (!value || typeof value !== "object") return false;
+	const v = value as Record<string, unknown>;
+	return (v.role === "observer" || v.role === "consolidator") && typeof v.runId === "string" &&
+		typeof v.cost === "number" && Number.isFinite(v.cost) && v.cost >= 0;
+}
+
+/** Sum every valid worker-cost record, including entries on abandoned branches. */
+export function totalWorkerCost(entries: Entry[]): number {
+	return entries.reduce((sum, entry) => entry.type === "custom" && entry.customType === OM_WORKER_COST && isWorkerCostData(entry.data)
+		? sum + entry.data.cost : sum, 0);
+}
 /** Promotion tombstones written by the orchestrator after a consolidator run (Phase B). */
 export const OM_OBSERVATIONS_DROPPED = "om.observations.dropped";
 /** Compaction details type stamped into the compaction entry's `details`. */
