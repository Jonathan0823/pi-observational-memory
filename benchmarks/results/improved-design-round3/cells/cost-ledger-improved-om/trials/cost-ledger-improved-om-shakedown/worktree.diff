+export type WorkerCost = { role: "observer" | "consolidator"; runId: string; cost: number };
+export const workerCostPath = (cwd: string, runId: string): string => join(runsDir(cwd), `${runId}.cost.json`);
+
+export function writeWorkerCost(path: string, cost: WorkerCost): void {
+	atomicWrite(path, JSON.stringify(cost));
+}
+
+export function readWorkerCost(path: string): WorkerCost | undefined {
+	try {
+		const value = JSON.parse(readFileSync(path, "utf-8")) as Record<string, unknown>;
+		if ((value.role !== "observer" && value.role !== "consolidator") || typeof value.runId !== "string" ||
+			typeof value.cost !== "number" || !Number.isFinite(value.cost) || value.cost < 0) return undefined;
+		return { role: value.role, runId: value.runId, cost: value.cost };
+	} catch {
+		return undefined;
+	}
+}
+
 export function runsDir(cwd: string): string {
 	return join(cwd, ".memory", ".runs");
 }
