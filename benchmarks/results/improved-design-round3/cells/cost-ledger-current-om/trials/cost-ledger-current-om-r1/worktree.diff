@@ -56,3 +62,34 @@ export function readObserverResult(path: string): ObserverRunResult {
 export function writeObserverResult(path: string, result: ObserverRunResult): void {
 	atomicWrite(path, JSON.stringify(result));
 }
+
+/** Read the cost handoff independently of observer payload validation or worker exit status. */
+export function readWorkerCostResult(path: string): WorkerCostResult | undefined {
+	try {
+		const raw = JSON.parse(readFileSync(path, "utf-8")) as unknown;
+		if (!raw || typeof raw !== "object") return undefined;
+		const cost = (raw as Record<string, unknown>).workerCost;
+		if (!cost || typeof cost !== "object") return undefined;
+		const value = cost as Record<string, unknown>;
+		if (
+			(value.role !== "observer" && value.role !== "consolidator") ||
+			typeof value.runId !== "string" || !value.runId ||
+			typeof value.cost !== "number" || !Number.isFinite(value.cost) || value.cost < 0
+		) return undefined;
+		return { role: value.role, runId: value.runId, cost: value.cost };
+	} catch {
+		return undefined;
+	}
+}
+
+/** Merge usage into the result file without discarding observations already flushed by tools. */
+export function writeWorkerCostResult(path: string, result: WorkerCostResult): void {
+	let existing: Record<string, unknown> = {};
+	try {
+		const raw = JSON.parse(readFileSync(path, "utf-8")) as unknown;
+		if (raw && typeof raw === "object" && !Array.isArray(raw)) existing = raw as Record<string, unknown>;
+	} catch {
+		// Worker costs must still be handed off if no role-specific result was written.
+	}
+	atomicWrite(path, JSON.stringify({ ...existing, workerCost: result }));
+}
