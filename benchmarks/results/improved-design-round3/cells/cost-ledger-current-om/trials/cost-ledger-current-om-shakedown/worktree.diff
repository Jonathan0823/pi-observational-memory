+export function readWorkerCost(path: string): number | undefined {
+	try {
+		const value = (JSON.parse(readFileSync(path, "utf-8")) as { cost?: unknown })?.cost;
+		return typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : undefined;
+	} catch {
