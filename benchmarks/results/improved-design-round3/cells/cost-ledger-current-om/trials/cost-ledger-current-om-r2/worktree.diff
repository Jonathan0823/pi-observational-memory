+export function registerWorkerCostReporter(pi: ExtensionAPI, costPath: string): void {
+	let totalCost = 0;
+	pi.on("message_end", async (event: { message: unknown }) => {
+		const message = event.message as { role?: unknown; usage?: { cost?: { total?: unknown } } };
+		const cost = message?.role === "assistant" ? message.usage?.cost?.total : undefined;
+		if (typeof cost !== "number" || !Number.isFinite(cost) || cost < 0) return;
+		const next = totalCost + cost;
+		if (!Number.isFinite(next)) return;
+		totalCost = next;
+		writeWorkerCost(costPath, totalCost);
+	});
+}
 
