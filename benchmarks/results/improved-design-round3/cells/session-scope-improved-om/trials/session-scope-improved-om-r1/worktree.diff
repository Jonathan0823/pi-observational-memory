+export function memoryDir(cwd: string, sessionId?: string, parentSessionPath?: string): string {
+	const projectMemory = join(cwd, ".memory");
+	if (!sessionId || !/^[A-Za-z0-9_-]+$/.test(sessionId)) return projectMemory;
+	const root = join(projectMemory, sessionId);
+	if (existsSync(root) || !parentSessionPath) return root;
+
+	try {
+		const firstLine = readFileSync(parentSessionPath, "utf-8").split("\n", 1)[0];
+		const header = JSON.parse(firstLine) as { type?: string; id?: string };
+		if (header.type !== "session" || !header.id || !/^[A-Za-z0-9_-]+$/.test(header.id)) return root;
+		const parentRoot = join(projectMemory, header.id);
+		if (!existsSync(parentRoot) || !statSync(parentRoot).isDirectory()) return root;
+		// Claim the absent child root once; existing child memory is never merged or overwritten.
+		mkdirSync(root);
+		for (const name of readdirSync(parentRoot)) {
+			if (name === ".runs") continue;
+			const from = join(parentRoot, name);
+			const to = join(root, name);
+			if (statSync(from).isDirectory()) copyMemoryTree(from, to);
+			else copyFileSync(from, to);
+		}
+	} catch {
+		// An unavailable parent leaves the child root absent until its first durable write.
+	}
+	return root;
+}
