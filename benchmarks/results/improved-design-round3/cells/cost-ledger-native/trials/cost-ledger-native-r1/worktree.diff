+/** Sum valid worker costs from all session entries (not just the active branch). */
+export function totalWorkerCost(entries: Entry[]): number {
+	let total = 0;
+	for (const entry of entries) {
+		if (!isCustomEntry(entry, OM_WORKER_COST) || !isWorkerCostData(entry.data)) continue;
+		const next = total + entry.data.cost;
+		if (Number.isFinite(next)) total = next;
+	}
+	return total;
