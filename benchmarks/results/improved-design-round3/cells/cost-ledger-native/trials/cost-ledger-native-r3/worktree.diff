+export type WorkerCostEntryData = { role: "observer" | "consolidator"; runId: string; cost: number };
+
+export function isWorkerCostEntryData(value: unknown): value is WorkerCostEntryData {
+	if (!value || typeof value !== "object") return false;
+	const data = value as Record<string, unknown>;
+	return (data.role === "observer" || data.role === "consolidator") &&
+		typeof data.runId === "string" && data.runId.length > 0 &&
+		typeof data.cost === "number" && Number.isFinite(data.cost) && data.cost >= 0;
+}
+
+/** Sum valid worker spend over every supplied session entry (the complete session tree). */
+export function totalWorkerCost(entries: Entry[]): number {
+	return entries.reduce((total, entry) => {
+		if (entry.type !== "custom" || entry.customType !== OM_WORKER_COST || !isWorkerCostEntryData(entry.data)) return total;
+		return total + entry.data.cost;
+	}, 0);
+}
