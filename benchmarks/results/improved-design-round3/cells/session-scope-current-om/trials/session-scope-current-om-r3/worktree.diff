+		writeFileSync(join(parentRoot, ".runs", "ipc.json"), "transient");
+		const parentSession = join(cwd, "parent.jsonl");
+		writeHeader(parentSession, parentId);
+
+		const childRoot = resolveSessionMemoryDir(cwd, { id: childId, parentSession });
+		expect(readFileSync(join(childRoot, "topic.md"), "utf-8")).toBe("parent content");
+		expect(existsSync(join(childRoot, ".runs"))).toBe(false);
+		writeFileSync(join(childRoot, "topic.md"), "child edit");
+		writeFileSync(join(parentRoot, "later.md"), "not reseeded");
+		resolveSessionMemoryDir(cwd, { id: childId, parentSession });
+		expect(readFileSync(join(childRoot, "topic.md"), "utf-8")).toBe("child edit");
+		expect(existsSync(join(childRoot, "later.md"))).toBe(false);
+	});
+
+	it("leaves the child root absent when parent metadata or memory is missing", () => {
+		const noHeaderRoot = resolveSessionMemoryDir(cwd, { id: "no-header", parentSession: join(cwd, "missing.jsonl") });
+		expect(existsSync(noHeaderRoot)).toBe(false);
+		const parentSession = join(cwd, "empty-parent.jsonl");
+		writeHeader(parentSession, "empty-parent");
+		const noMemoryRoot = resolveSessionMemoryDir(cwd, { id: "no-memory", parentSession });
+		expect(existsSync(noMemoryRoot)).toBe(false);
 	});
 });
 
