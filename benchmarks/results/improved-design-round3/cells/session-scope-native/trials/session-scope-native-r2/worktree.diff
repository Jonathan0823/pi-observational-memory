+/** Read the immutable ID from a session JSONL header. */
+export function readSessionHeader(sessionPath: string): { id: string; cwd?: string; parentSession?: string } | undefined {
+	try {
+		const firstLine = readFileSync(sessionPath, "utf-8").split("\n", 1)[0];
+		const header = JSON.parse(firstLine) as { type?: unknown; id?: unknown; cwd?: unknown; parentSession?: unknown };
+		if (header.type !== "session" || typeof header.id !== "string" || !header.id) return undefined;
+		return {
+			id: header.id,
+			cwd: typeof header.cwd === "string" ? header.cwd : undefined,
+			parentSession: typeof header.parentSession === "string" ? header.parentSession : undefined,
+		};
+	} catch {
+		return undefined;
+	}
+}
+
+/** Ensure a session's root exists, copying its parent's durable files exactly once. */
+export function ensureSessionMemoryDir(cwd: string, sessionId: string, parentSession?: string): string {
+	const destination = memoryDir(cwd, sessionId);
+	if (existsSync(destination)) return destination;
+
+	if (parentSession) {
+		const parentHeader = readSessionHeader(isAbsolute(parentSession) ? parentSession : resolve(cwd, parentSession));
+		if (parentHeader) {
+			const parentRoot = memoryDir(parentHeader.cwd || cwd, parentHeader.id);
+			if (existsSync(parentRoot) && statSync(parentRoot).isDirectory()) {
+				mkdirSync(destination, { recursive: true });
+				for (const name of readdirSync(parentRoot)) {
+					if (name === ".runs") continue;
+					cpSync(join(parentRoot, name), join(destination, name), { recursive: true, errorOnExist: true, force: false });
+				}
+				return destination;
+			}
+		}
+	}
+	return destination;
+}
